<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="controller.productcontroller" 
            prefHeight="700.0" prefWidth="1200.0">
    
    
    <top>
        <VBox style="-fx-background-color: linear-gradient(to right, #667eea 0%, #764ba2 100%);">
            <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-padding: 20;">
                <Label text="📦 Gestion de Stock" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: white;">
                    <font>
                        <Font name="System Bold" size="28.0"/>
                    </font>
                </Label>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="welcomeLabel" text="Bienvenue" style="-fx-font-size: 16px; -fx-text-fill: white;"/>
            </HBox>
            
            
            <HBox spacing="30" alignment="CENTER" style="-fx-padding: 0 20 20 20;">
                <VBox alignment="CENTER" spacing="5" style="-fx-background-color: rgba(255,255,255,0.2); -fx-background-radius: 10; -fx-padding: 15 30 15 30;">
                    <Label fx:id="totalProductsLabel" text="Total de produits: 0" 
                           style="-fx-font-size: 16px; -fx-text-fill: white; -fx-font-weight: bold;"/>
                </VBox>
                <VBox alignment="CENTER" spacing="5" style="-fx-background-color: rgba(255,255,255,0.2); -fx-background-radius: 10; -fx-padding: 15 30 15 30;">
                    <Label fx:id="totalValueLabel" text="Valeur totale du stock: 0.00 DZD" 
                           style="-fx-font-size: 16px; -fx-text-fill: white; -fx-font-weight: bold;"/>
                </VBox>
            </HBox>
        </VBox>
    </top>
    
    <center>
        <VBox spacing="15" style="-fx-padding: 20;">
            
            
            <HBox spacing="15" alignment="CENTER_LEFT" style="-fx-background-color: #f8f9fa; -fx-padding: 15; -fx-background-radius: 10;">
                
                
                <VBox spacing="5">
                    <Label text="Rechercher" style="-fx-font-size: 12px; -fx-text-fill: #666; -fx-font-weight: bold;"/>
                    <HBox spacing="5">
                        <TextField fx:id="searchField" promptText="Nom ou catégorie..." 
                                   style="-fx-background-radius: 8; -fx-padding: 8;"
                                   prefWidth="250"/>
                        <Button text="🔍 Rechercher" onAction="#handleSearch" 
                                style="-fx-background-color: #667eea; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand; -fx-padding: 8 15 8 15; -fx-font-weight: bold;"/>
                    </HBox>
                </VBox>
                
                <Separator orientation="VERTICAL" prefHeight="50"/>
                
                
                <VBox spacing="5">
                    <Label text="Filtrer par catégorie" style="-fx-font-size: 12px; -fx-text-fill: #666; -fx-font-weight: bold;"/>
                    <ComboBox fx:id="categoryFilter" onAction="#handleCategoryFilter" 
                              style="-fx-background-radius: 8;"
                              prefWidth="200"/>
                </VBox>
                
                <Region HBox.hgrow="ALWAYS"/>
                
                
                <VBox spacing="5" alignment="CENTER_RIGHT">
                    <Label text="Actions" style="-fx-font-size: 12px; -fx-text-fill: #666; -fx-font-weight: bold;"/>
                    <HBox spacing="10">
                        <Button text="➕ Ajouter" onAction="#handleAddProduct" 
                                style="-fx-background-color: #28a745; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand; -fx-padding: 8 15 8 15; -fx-font-weight: bold;"/>
                        <Button text="✏️ Modifier" onAction="#handleEditProduct" 
                                style="-fx-background-color: #ffc107; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand; -fx-padding: 8 15 8 15; -fx-font-weight: bold;"/>
                        <Button text="🗑️ Supprimer" onAction="#handleDeleteProduct" 
                                style="-fx-background-color: #dc3545; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand; -fx-padding: 8 15 8 15; -fx-font-weight: bold;"/>
                        <Button text="🔄 Actualiser" onAction="#handleRefresh" 
                                style="-fx-background-color: #17a2b8; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand; -fx-padding: 8 15 8 15; -fx-font-weight: bold;"/>
                    </HBox>
                </VBox>
            </HBox>
            
            
            <TableView fx:id="productsTable" VBox.vgrow="ALWAYS" 
                       style="-fx-background-radius: 10; -fx-border-color: #ddd; -fx-border-radius: 10;">
                <columns>
                    <TableColumn fx:id="idColumn" text="ID" prefWidth="60" style="-fx-alignment: CENTER;"/>
                    <TableColumn fx:id="nameColumn" text="Nom du produit" prefWidth="200"/>
                    <TableColumn fx:id="descriptionColumn" text="Description" prefWidth="250"/>
                    <TableColumn fx:id="priceColumn" text="Prix (DZD)" prefWidth="120" style="-fx-alignment: CENTER-RIGHT;"/>
                    <TableColumn fx:id="quantityColumn" text="Quantité" prefWidth="100" style="-fx-alignment: CENTER;"/>
                    <TableColumn fx:id="categoryColumn" text="Catégorie" prefWidth="150" style="-fx-alignment: CENTER;"/>
                    <TableColumn fx:id="statusColumn" text="Statut" prefWidth="150" style="-fx-alignment: CENTER;"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
            
        </VBox>
    </center>
    
    <bottom>
        <HBox alignment="CENTER" style="-fx-background-color: #f8f9fa; -fx-padding: 15;">
            <Label text="Système de Gestion de Stock - Mini Projet POO - 2CS 2025" 
                   style="-fx-text-fill: #666; -fx-font-size: 12px;"/>
        </HBox>
    </bottom>
</BorderPane>

