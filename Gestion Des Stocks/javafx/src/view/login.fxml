<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="controller.logincontroller" 
            prefHeight="500.0" prefWidth="600.0" 
            style="-fx-background-color: linear-gradient(to bottom, #667eea 0%, #764ba2 100%);">
    
    <center>
        <VBox alignment="CENTER" spacing="20.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 15, 0, 0, 5);" maxWidth="400" maxHeight="450">
            <padding>
                <Insets top="40" right="50" bottom="40" left="50"/>
            </padding>
            
            
            <Label text="Gestion de Stock" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #667eea;">
                <font>
                    <Font name="System Bold" size="32.0"/>
                </font>
            </Label>
            
            <Label text="Connexion" style="-fx-font-size: 18px; -fx-text-fill: #666;">
                <font>
                    <Font size="18.0"/>
                </font>
            </Label>
            
            <Separator prefWidth="200.0"/>
            
            
            <VBox spacing="8">
                <Label text="Nom d'utilisateur" style="-fx-font-size: 14px; -fx-text-fill: #333; -fx-font-weight: bold;"/>
                <TextField fx:id="usernameField" promptText="Entrez votre nom d'utilisateur" 
                           style="-fx-background-color: #f5f5f5; -fx-background-radius: 8; -fx-border-color: #ddd; -fx-border-radius: 8; -fx-padding: 12;"
                           prefHeight="45"/>
            </VBox>
            
            
            <VBox spacing="8">
                <Label text="Mot de passe" style="-fx-font-size: 14px; -fx-text-fill: #333; -fx-font-weight: bold;"/>
                <PasswordField fx:id="passwordField" promptText="Entrez votre mot de passe" 
                               style="-fx-background-color: #f5f5f5; -fx-background-radius: 8; -fx-border-color: #ddd; -fx-border-radius: 8; -fx-padding: 12;"
                               prefHeight="45"/>
            </VBox>
            
            
            <Label fx:id="errorLabel" style="-fx-font-size: 13px; -fx-text-fill: red;" wrapText="true"/>
            
            
            <HBox spacing="15" alignment="CENTER">
                <Button fx:id="loginButton" text="Se connecter" onAction="#handleLogin" 
                        style="-fx-background-color: #667eea; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand; -fx-padding: 12 30 12 30;"
                        prefWidth="150" prefHeight="45"/>
                <Button text="Annuler" onAction="#handleCancel" 
                        style="-fx-background-color: #f5f5f5; -fx-text-fill: #666; -fx-font-size: 14px; -fx-background-radius: 8; -fx-cursor: hand; -fx-padding: 12 30 12 30;"
                        prefWidth="120" prefHeight="45"/>
            </HBox>
            
            
            <VBox spacing="5" alignment="CENTER" style="-fx-padding: 20 0 0 0;">
                <Label text="Compte par défaut:" style="-fx-font-size: 11px; -fx-text-fill: #999;"/>
                <Label text="Utilisateur: admin | Mot de passe: admin" style="-fx-font-size: 11px; -fx-text-fill: #999; -fx-font-style: italic;"/>
            </VBox>
        </VBox>
    </center>
    
    <bottom>
        <HBox alignment="CENTER" style="-fx-padding: 20;">
            <Label text="© 2025 Institut Supérieur d'Informatique - 2CS" style="-fx-text-fill: white; -fx-font-size: 12px;"/>
        </HBox>
    </bottom>
</BorderPane>

